APP_ENV=development
DATABASE_URL=postgresql+psycopg://shixu:change-me@localhost:5432/shixu
SESSION_COOKIE_NAME=shixu_session
APP_ORIGIN=http://localhost:8000
CSRF_SECRET=replace-with-random-32-byte-secret
# Preferred for the DeepSeek end-to-end trial. Keep the key only in local .env.
OPENAI_NEXT_API_KEY=
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_MODEL=deepseek-v3.2
# MiMo remains available when OPENAI_NEXT_API_KEY is empty.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
AGENT_MAX_MODEL_REQUESTS=16
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_RUN_SECONDS=180
AGENT_MAX_INPUT_TOKENS=64000
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_USER_HOUR_LIMIT=10
AGENT_USER_CONCURRENT_LIMIT=2
AGENT_IP_HOUR_LIMIT=30
AGENT_GLOBAL_MINUTE_LIMIT=10
AGENT_EVENT_RETENTION_DAYS=7
